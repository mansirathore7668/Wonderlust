<%layout("/layouts/boilerplate") %>

<div class="wl-auth">
  <div class="row g-0 wl-auth-shell">
    <div class="col-lg-6 wl-auth-aside">
      <div class="wl-auth-aside-inner">
        <a class="wl-auth-brand" href="/" aria-label="Wonderlust home">
          <i class="fa-solid fa-compass"></i>
          <span>wonderlust</span>
        </a>
        <h2 class="wl-auth-title">Welcome back</h2>
        <p class="wl-auth-subtitle mb-0">Log in to manage your listings, reviews, and trips.</p>

        <div class="wl-auth-badges mt-4">
          <div class="wl-auth-badge"><i class="fa-solid fa-shield-halved"></i> Secure sign-in</div>
          <div class="wl-auth-badge"><i class="fa-solid fa-bolt"></i> Fast & simple</div>
          <div class="wl-auth-badge"><i class="fa-solid fa-heart"></i> wonderlust-ish UI</div>
        </div>
      </div>
    </div>

    <div class="col-lg-6 wl-auth-main">
      <div class="wl-auth-card">
        <div class="wl-auth-card-top">
          <h3 class="mb-1">Log in</h3>
          <p class="text-muted mb-0">Use your username and password.</p>
        </div>

        <form action="/login" method="POST" novalidate class="needs-validation mt-3" data-disable-validation="true">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <div class="input-group">
              <span class="input-group-text bg-white"><i class="fa-regular fa-user"></i></span>
              <input
                type="text"
                class="form-control"
                id="username"
                name="username"
                placeholder="Enter username"
                autocomplete="username"
                required
              />
              <div class="invalid-feedback">Please enter your username</div>
            </div>
          </div>
       
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <div class="input-group">
              <span class="input-group-text bg-white"><i class="fa-solid fa-lock"></i></span>
              <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                placeholder="Enter password"
                autocomplete="current-password"
                required
              />
              <div class="invalid-feedback">Please enter your password</div>
            </div>
          </div>

          <button type="submit" class="btn btn-dark wl-auth-btn w-100">Continue</button>

          <div class="wl-auth-foot mt-3">
            <span class="text-muted">New here?</span>
            <a href="/signup" class="wl-auth-link">Create an account</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
