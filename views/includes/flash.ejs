<% if (typeof successMessage !== "undefined" && successMessage) { %>
<div class="wl-flash alert alert-success alert-dismissible fade show" role="alert">
    <%= successMessage %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } else if(success && success.length) {%>
<div class="wl-flash alert alert-success alert-dismissible fade show" role="alert">
    <%= success.join(" ") %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%} %>

<% if(error && error.length) {%>
<div class="wl-flash alert alert-danger alert-dismissible fade show" role="alert">
    <%= error.join(" ") %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%} %>
